# Copy this file to `.env` in the project root:
# D:\HelioPrior\.env

# 1) Bailian / DashScope model API
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://llm-jz60biyiqkkwzssm.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen3.8-flash

# 2) Optional Bailian knowledge-base search
# Use the official knowledge search API:
# POST https://{workspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/indices/knowledge/search
BAILIAN_WORKSPACE_ID=
BAILIAN_KNOWLEDGE_AGENT_ID=
BAILIAN_KNOWLEDGE_AGENT_VERSION=

# Optional override. Usually leave empty and let the code derive the endpoint
# from BAILIAN_WORKSPACE_ID automatically.
BAILIAN_KNOWLEDGE_SEARCH_ENDPOINT=

# 3) Optional real API test switch
# Set to 1 only when you want to run real remote integration smoke tests.
ENABLE_REAL_API_TESTS=0
